{
  "name": "@m4tic/mcp-server",
  "version": "0.1.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M4TIC-tech/token-efficient-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "dashboards",
    "token-efficiency",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "token-efficient-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/copy-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/index.ts"
  },
  "dependencies": {
    "zod-to-json-schema": "^3.23.0",
    "@m4tic/core": "workspace:*",
    "@m4tic/renderer-html": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
